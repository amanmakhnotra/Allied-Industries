# Application secret key
# Used by the application for session/security-related operations.
# Replace with a strong random value in a real deployment.
SECRET_KEY=dummy-secret-key-for-local-development-only

# Database connection
# SQLite database file used by the application.
DATABASE_URL=sqlite:///allied.db

# Gmail SMTP server configuration
# Used for sending email notifications from the application.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Email account credentials
# Use a Gmail address and App Password in a real deployment.
MAIL_USERNAME=dummy@example.com
MAIL_PASSWORD=dummy-app-password

# Email address that receives application/admin notifications.
ADMIN_NOTIFY_EMAIL=dummy@example.com
