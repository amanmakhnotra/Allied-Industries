# ─────────────────────────────────────────────────────────────
#  Allied Industries – Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Flask secret key — generate a long random string for production
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database — defaults to SQLite (allied.db) if not set
# For PostgreSQL: postgresql://user:password@localhost/allied_db
DATABASE_URL=sqlite:///allied.db

# ── Gmail SMTP ──────────────────────────────────────────────
# Use a Gmail App Password (not your normal password).
# Enable at: myaccount.google.com → Security → App passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@alliedindustries.in
MAIL_PASSWORD=your-16-char-app-password-here

# Where admin notification emails are sent
ADMIN_NOTIFY_EMAIL=info@alliedindustries.in
